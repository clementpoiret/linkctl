{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clementpoiret/linkctl/schemas/preset-v1.json",
  "title": "linkctl preset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "requirements", "standard_controls"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$",
      "not": {"enum": [".", ".."]}
    },
    "description": {"type": ["string", "null"]},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "fallback"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "usb_vid": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "usb_pid": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
        "fallback": {"const": "fail"}
      }
    },
    "video": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fourcc", "width", "height", "fps_num", "fps_den"],
      "properties": {
        "fourcc": {"type": "string", "minLength": 4, "maxLength": 4},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps_num": {"type": "integer", "minimum": 1},
        "fps_den": {"type": "integer", "minimum": 1}
      }
    },
    "standard_controls": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9_]+$"},
      "additionalProperties": {"type": "integer"}
    },
    "audio": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["source", "layer"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "layer": {"enum": ["hardware", "host"]},
        "gain_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "mute": {"type": ["boolean", "null"]}
      },
      "anyOf": [
        {"properties": {"gain_percent": {"type": "number"}}, "required": ["gain_percent"]},
        {"properties": {"mute": {"type": "boolean"}}, "required": ["mute"]}
      ]
    }
  },
  "anyOf": [
    {"properties": {"video": {"type": "object"}}, "required": ["video"]},
    {"properties": {"standard_controls": {"minProperties": 1}}},
    {"properties": {"audio": {"type": "object"}}, "required": ["audio"]}
  ]
}
