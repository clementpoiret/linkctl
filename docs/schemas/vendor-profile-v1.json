{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clementpoiret/linkctl/schemas/vendor-profile-v1.json",
  "title": "linkctl vendor profile v1 (TOML data model)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "model", "status", "match"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "status": {"enum": ["read-only", "experimental", "verified"]},
    "provenance": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "match": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/match"}},
    "controls": {"type": "array", "items": {"$ref": "#/$defs/control"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "usb_vid",
        "usb_pid",
        "bcd_device_min",
        "bcd_device_max",
        "descriptor_sha256"
      ],
      "properties": {
        "mode": {"enum": ["camera", "u-disk", "unknown"]},
        "usb_vid": {"type": "integer", "minimum": 0, "maximum": 65535},
        "usb_pid": {"type": "integer", "minimum": 0, "maximum": 65535},
        "bcd_device_min": {"type": "integer", "minimum": 0, "maximum": 65535},
        "bcd_device_max": {"type": "integer", "minimum": 0, "maximum": 65535},
        "descriptor_sha256": {"$ref": "#/$defs/sha256"},
        "firmware": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "offset", "width", "codec"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "offset": {"type": "integer", "minimum": 0},
        "width": {"enum": [1, 2, 4, 8]},
        "codec": {"enum": ["boolean", "unsigned", "signed", "enum", "bitmask"]},
        "byte_order": {"enum": ["little", "big"]},
        "values": {"type": "object", "additionalProperties": {"type": "integer"}}
      }
    },
    "tail": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"enum": ["preserve", "zero"]}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hex"],
          "properties": {
            "kind": {"const": "fixed"},
            "hex": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{2})*$"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "algorithm"],
          "properties": {
            "kind": {"const": "computed"},
            "algorithm": {"enum": ["sum8", "xor8"]}
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "entity_guid",
        "selector",
        "length",
        "readable",
        "writable",
        "codec"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "entity_guid": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "selector": {"type": "integer", "minimum": 1, "maximum": 255},
        "length": {"type": "integer", "minimum": 1, "maximum": 65535},
        "readable": {"type": "boolean"},
        "writable": {"type": "boolean"},
        "codec": {
          "enum": ["raw", "boolean", "unsigned", "signed", "enum", "bitmask", "rectangle", "structured"]
        },
        "offset": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 0, "maximum": 8},
        "byte_order": {"enum": ["little", "big"]},
        "values": {"type": "object", "additionalProperties": {"type": "integer"}},
        "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}},
        "read_modify_write": {"type": "boolean"},
        "tail_policy": {"$ref": "#/$defs/tail"},
        "verification": {
          "enum": ["readback", "status", "video-observation", "audio-observation", "reenumeration", "manual"]
        },
        "stream_requirement": {"enum": ["closed", "open", "either", "restart"]},
        "preconditions": {"type": "array", "items": {"type": "string"}},
        "postconditions": {"type": "array", "items": {"type": "string"}},
        "minimum_write_interval_ms": {"type": "integer", "minimum": 0},
        "persistence": {"enum": ["volatile", "stream", "reconnect", "power-cycle"]},
        "rollback": {"enum": ["readback", "none"]},
        "trace_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "safety": {"enum": ["normal", "firmware", "boot", "flash", "calibration", "motor"]},
        "snapshot": {"enum": ["include", "volatile", "exclude"]}
      }
    }
  }
}
